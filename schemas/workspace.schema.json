{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "workspace-1"
    },
    "records": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projects": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "question_source": {
            "type": "string",
            "minLength": 1
          },
          "question_section": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "root",
          "question_source"
        ]
      }
    },
    "claim_reviews": {
      "maxItems": 1000,
      "items": {
        "required": [
          "input",
          "result",
          "result_sha256"
        ],
        "properties": {
          "result": {
            "minLength": 1,
            "type": "string"
          },
          "input": {
            "minLength": 1,
            "type": "string"
          },
          "result_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "records",
    "projects"
  ]
}
