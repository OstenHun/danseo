{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relations"],
  "properties": {
    "schema_version": {"const": "relations-1"},
    "relations": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "target", "kind", "origin", "status", "rationale", "created_by", "snapshots", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "source": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "kind": {"enum": ["cites", "extends", "compares", "related-to", "reading-order"]},
          "origin": {"enum": ["source", "ai"]},
          "status": {"enum": ["proposed", "source-checked"]},
          "rationale": {"type": "string", "pattern": "\\S"},
          "created_by": {"type": "string", "pattern": "\\S"},
          "snapshots": {
            "type": "object", "additionalProperties": false, "required": ["source", "target"],
            "properties": {"source": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "target": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "dependencies": {
                "type":"object","additionalProperties":false,"required":["format","relation_sha256","sources","claims"],
                "properties": {
                  "format":{"const":"relation-dependencies-1"},
                  "relation_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
                  "sources":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["paper_id","sha256"],"properties":{"paper_id":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
                  "claims":{"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["paper_id","claim_id","sha256"],"properties":{"paper_id":{"type":"string","minLength":1},"claim_id":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
                }
              }
            }
          },
          "evidence_refs": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["paper_id", "claim_id"],
              "properties": {"paper_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}}
            }
          },
          "review": {
            "type": "object", "additionalProperties": false, "required": ["checked_by", "checked_at"],
            "properties": {
              "checked_by": {"type": "string", "pattern": "\\S"},
              "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"}
            }
          }
        },
        "if": {"properties": {"status": {"const": "source-checked"}}},
        "then": {"required": ["review"], "properties": {"review": {}, "evidence_refs": {"type": "array", "minItems": 1}}}
      }
    }
  }
}
