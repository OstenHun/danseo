{
  "name": "danseo",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "description": "Local paper evidence validation and agent context bundles",
  "license": "MIT",
  "keywords": [
    "research",
    "papers",
    "evidence",
    "cli",
    "agent-skills"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "bin": {
    "danseo": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills/danseo",
    "examples/minimal",
    "docs",
    "evals",
    "TASKS.md",
    "AGENTS.md",
    "README.en.md",
    "README.ko.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "third-party-licenses",
    "assets/brand",
    "assets/readme",
    "!**/.gitkeep"
  ],
  "scripts": {
    "build": "npm run build:tools && tsc && tsc -p tsconfig.browser.json && node build-tools/build-browser.js && node build-tools/copy-comparison.js",
    "test": "npm run build:tests && node --test build/*.test.js && npm run test:research-evidence",
    "check:docs": "npm run build:tools && node build-tools/check-docs.js",
    "test:package": "npm run build:tests && node build/package-smoke.js",
    "danseo": "node dist/cli.js",
    "build:tests": "npm run build && node build-tools/clean-test-build.js && tsc -p tsconfig.tests.json",
    "check:tests": "npm run build && tsc -p tsconfig.tests.json --noEmit",
    "build:tools": "tsc -p tsconfig.tools.json",
    "test:research-evidence": "node --test skills/danseo/scripts/research-evidence.test.mjs skills/danseo/scripts/performance-evidence.test.mjs skills/danseo/scripts/research-view.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cytoscape": "3.34.4",
    "unpdf": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
